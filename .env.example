# App
APP_NAME=go-agent
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
# Logger
LOG_LEVEL=debug
# PG
PG_POOL_MAX=2
PG_URL=postgres://user:myAwEsOm3pa55@w0rd@localhost:5432/db
# Redis
REDIS_URL=redis://localhost:6379/0
# AgentOS
AGENTOS_ARTIFACT_STORE_BACKEND=local
AGENTOS_ARTIFACT_STORE_LOCAL_ROOT=.data/agentos-artifacts
AGENTOS_ARTIFACT_STORE_S3_BUCKET=
AGENTOS_ARTIFACT_STORE_S3_REGION=
AGENTOS_ARTIFACT_STORE_S3_ENDPOINT=
AGENTOS_ARTIFACT_STORE_S3_ACCESS_KEY_ID=
AGENTOS_ARTIFACT_STORE_S3_SECRET_ACCESS_KEY=
AGENTOS_ARTIFACT_STORE_S3_SESSION_TOKEN=
AGENTOS_ARTIFACT_STORE_S3_FORCE_PATH_STYLE=false
AGENTOS_CAPABILITIES_JSON=[]
AGENTOS_PLAN_COMMAND_RECOVERY_ENABLED=true
AGENTOS_PLAN_COMMAND_RECOVERY_INTERVAL_SECONDS=30
AGENTOS_PLAN_COMMAND_RECOVERY_LIMIT=100
AGENTOS_PLAN_COMMAND_RECOVERY_IMMEDIATE_ON_WORKER_RUN=true
# gRPC
GRPC_PORT=8081
# RMQ
RMQ_RPC_SERVER=rpc_server
RMQ_RPC_CLIENT=rpc_client
RMQ_URL=amqp://guest:guest@localhost:5672/
# NATS
NATS_RPC_SERVER=rpc_server
NATS_URL=nats://guest:guest@localhost:4222/
# Agent Framework (Temporal)
AGENTFW_ENABLED=true
AGENTFW_ROLLOUT_MODE=disabled
AGENTFW_ROLLOUT_PERCENT=0
AGENTFW_ROLLOUT_ALLOWLIST=
AGENTFW_ROLLBACK_FORCE_LEGACY=false
AGENTFW_ROLLOUT_HASH_SALT=agentfw-v1
AGENTFW_TEMPORAL_ADDRESS=127.0.0.1:7233
AGENTFW_TEMPORAL_NAMESPACE=default
AGENTFW_TEMPORAL_PLAN_CONTROL_TASK_QUEUE=agentos-plan-control
AGENTFW_TEMPORAL_PLAN_ACTIVITY_TASK_QUEUE=agentos-plan-activity
AGENTFW_TEMPORAL_PROCESS_CONTROL_TASK_QUEUE=agentos-process-control
AGENTFW_TEMPORAL_PROCESS_ACTIVITY_TASK_QUEUE=agentos-process-activity
AGENTFW_TEMPORAL_NATIVE_CONTROL_TASK_QUEUE=agentfw-native-control
AGENTFW_TEMPORAL_NATIVE_LLM_TASK_QUEUE=agentfw-native-llm
AGENTFW_TEMPORAL_NATIVE_TOOL_TASK_QUEUE=agentfw-native-tool
AGENTFW_TEMPORAL_STREAM_TASK_QUEUE=agentfw-stream
AGENTFW_TEMPORAL_TRIGGER_TASK_QUEUE=agentfw-trigger
AGENTFW_MAX_CONCURRENT_WORKFLOW_TASK_POLLERS=2
AGENTFW_MAX_CONCURRENT_ACTIVITY_TASK_POLLERS=2
AGENTFW_MAX_CONCURRENT_ACTIVITY_EXECUTION=100
AGENTFW_CONTINUE_AS_NEW_STEP_THRESHOLD=80
AGENTFW_CONTINUE_AS_NEW_HISTORY_THRESHOLD=10000
AGENTFW_CONTINUE_AS_NEW_STATE_SIZE_THRESHOLD_BYTES=524288
AGENTFW_CONTINUE_AS_NEW_WALL_CLOCK_THRESHOLD_SECONDS=3000
AGENTFW_CONTINUE_AS_NEW_MAX_CONTINUATIONS=1000
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=true
