# App
APP_NAME=go-agent
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
# Logger
LOG_LEVEL=info
# PG
PG_POOL_MAX=2
PG_URL=postgres://user@localhost:5432/db
# Redis
REDIS_URL=redis://localhost:6379/0
# Auth — required. The service refuses to start without exactly one key source
# and an issuer or audience binding the token to this service.
# Local development uses a shared secret; leave AUTH_JWKS_URL empty then.
AUTH_HMAC_SECRET=dev-only-shared-secret-not-for-production

# --- MCP transport policy ----------------------------------------------------
# What an MCP server configuration (agent/template/request-shaped data) may
# make this host do. Empty by default: no stdio command runs, and network
# transports only reach public addresses.
#
# MCP_ALLOWED_COMMANDS=   # exact executables, e.g. npx,uvx — empty runs nothing
# MCP_INHERITED_ENV=PATH,HOME
# MCP_CONFIG_ENV=         # keys a server config may set itself, e.g. WEATHER_API_KEY
# MCP_ALLOWED_HTTP_HOSTS= # internal-network MCP servers trusted by name, e.g. mcp.internal
# Production: the issuer's JWK Set (identity provider or authenticating
# gateway). When set, it replaces AUTH_HMAC_SECRET.
AUTH_JWKS_URL=
AUTH_ISSUER=goagent-dev
AUTH_AUDIENCE=goagent
AUTH_LEEWAY_SECONDS=0
# Claim names carrying the tenant boundary and the acting party.
AUTH_ACCOUNT_CLAIM=sub
AUTH_ACTOR_CLAIM=act
# Paths reachable without a credential. Exact match, except entries ending in
# "/*" which match by prefix. Keep this minimal outside development.
AUTH_PUBLIC_PATHS=/healthz
# AgentOS
AGENTOS_ARTIFACT_STORE_BACKEND=local
AGENTOS_ARTIFACT_STORE_LOCAL_ROOT=.data/agentos-artifacts
AGENTOS_ARTIFACT_STORE_S3_BUCKET=
AGENTOS_ARTIFACT_STORE_S3_REGION=
AGENTOS_ARTIFACT_STORE_S3_ENDPOINT=
AGENTOS_ARTIFACT_STORE_S3_ACCESS_KEY_ID=
AGENTOS_ARTIFACT_STORE_S3_SECRET_ACCESS_KEY=
AGENTOS_ARTIFACT_STORE_S3_SESSION_TOKEN=
AGENTOS_ARTIFACT_STORE_S3_FORCE_PATH_STYLE=false
AGENTOS_CAPABILITIES_JSON=[]
AGENTOS_PLAN_COMMAND_RECOVERY_ENABLED=true
AGENTOS_PLAN_COMMAND_RECOVERY_INTERVAL_SECONDS=30
AGENTOS_PLAN_COMMAND_RECOVERY_LIMIT=100
AGENTOS_PLAN_COMMAND_RECOVERY_IMMEDIATE_ON_WORKER_RUN=true
# gRPC
GRPC_PORT=8081
# Agent Framework (Temporal)
AGENTFW_ENABLED=true
AGENTFW_ROLLOUT_MODE=disabled
AGENTFW_ROLLOUT_PERCENT=0
AGENTFW_ROLLOUT_ALLOWLIST=
AGENTFW_ROLLBACK_FORCE_LEGACY=false
AGENTFW_ROLLOUT_HASH_SALT=agentfw-v1
AGENTFW_TEMPORAL_ADDRESS=127.0.0.1:7233
AGENTFW_TEMPORAL_NAMESPACE=default
AGENTFW_TEMPORAL_NEXUS_ENDPOINT=agentos
AGENTFW_TEMPORAL_PLAN_CONTROL_TASK_QUEUE=agentos-plan-control
AGENTFW_TEMPORAL_PLAN_ACTIVITY_TASK_QUEUE=agentos-plan-activity
AGENTFW_TEMPORAL_PROCESS_CONTROL_TASK_QUEUE=agentos-process-control
AGENTFW_TEMPORAL_PROCESS_ACTIVITY_TASK_QUEUE=agentos-process-activity
AGENTFW_TEMPORAL_NATIVE_CONTROL_TASK_QUEUE=agentfw-native-control
AGENTFW_TEMPORAL_NATIVE_LLM_TASK_QUEUE=agentfw-native-llm
AGENTFW_TEMPORAL_NATIVE_TOOL_TASK_QUEUE=agentfw-native-tool
AGENTFW_TEMPORAL_STREAM_TASK_QUEUE=agentfw-stream
# Router queue hosting the Nexus service that fronts the AgentOS run API.
AGENTFW_TEMPORAL_NEXUS_TASK_QUEUE=agentos-nexus
# Peer towns this deployment issues operations to, as {town: Nexus endpoint}.
# Endpoint names are namespace-scoped, so a plan node that must run in another
# town names it in `peer` and this map resolves the endpoint. Empty = every node
# runs here.
AGENTFW_NEXUS_PEERS_JSON={}
# Event backbone: NATS JetStream. `make compose-up` starts the broker and
# provisions the streams; leaving this empty disables the backbone, which is
# how a host-side `make run` behaves.
AGENTFW_NATS_URL=
AGENTFW_NATS_SUBJECT_PREFIX=agentos
# Shard count for per-entity ordering. Chosen once: changing it remaps entities
# and breaks ordering across the change.
AGENTFW_NATS_SHARDS=16
# Cross-town ingress: turn friend-cell facts into Temporal work. Empty route
# table = off (a town that reacts to nobody's facts). Each route names the log
# domain to consume, the fact type to match, and the workflow that fact starts
# or signals; which towns react to which facts is deployment policy, so it is
# configuration rather than code.
# AGENTFW_INGRESS_ROUTES_JSON=[{"domain":"run.timeline","type":"run.requested","workflow_type":"agentfw.agent-workflow.v1","signal_name":"fact"}]
AGENTFW_INGRESS_ROUTES_JSON=[]
# Task queue hosting the workflows routed facts start or signal. Required once a
# route exists: a route into a queue nobody polls would swallow cross-town work.
AGENTFW_INGRESS_TASK_QUEUE=
# Durable consumer prefix; domain and shard group are appended, so two processes
# can never share a consumer by accident.
AGENTFW_INGRESS_CONSUMER_PREFIX=agentos-ingress
# Shards this process consumes ("0-7,12"). Empty owns every shard, which is
# always correct; a subset is how the bridge scales out.
AGENTFW_INGRESS_SHARDS=
AGENTFW_MAX_CONCURRENT_WORKFLOW_TASK_POLLERS=2
AGENTFW_MAX_CONCURRENT_ACTIVITY_TASK_POLLERS=2
AGENTFW_MAX_CONCURRENT_ACTIVITY_EXECUTION=100
AGENTFW_CONTINUE_AS_NEW_STEP_THRESHOLD=80
AGENTFW_CONTINUE_AS_NEW_HISTORY_THRESHOLD=10000
AGENTFW_CONTINUE_AS_NEW_STATE_SIZE_THRESHOLD_BYTES=524288
AGENTFW_CONTINUE_AS_NEW_WALL_CLOCK_THRESHOLD_SECONDS=3000
AGENTFW_CONTINUE_AS_NEW_MAX_CONTINUATIONS=1000
# DeepSeek Harness SDK backends: JSON array of {name, command, profile, args, env, working_dir}.
# The dsh SDK subprocess streams run events onto the message bus (never a direct
# frontend SSE). command defaults to "dsh", profile defaults to "sdk".
AGENTFW_DSH_BACKENDS_JSON=[]
# Data-plane bus: Centrifugo is the default transport. Set BASE_URL to point
# at a Centrifugo server (docker-compose: http://centrifugo:8000); leave empty
# to degrade to the in-process memstream bus (single-machine run, logs a WARN).
CENTRIFUGO_BASE_URL=
# Required by docker-compose.dev.yml, which refuses to start without them. They
# are deliberately empty in the repository: every deployment (a laptop or a
# cluster) generates its own, so no credential here is one somebody might
# inherit. `make dev-secrets` fills them in with fresh values.
CENTRIFUGO_ADMIN_PASSWORD=
CENTRIFUGO_ADMIN_SECRET=
CENTRIFUGO_API_KEY=
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=false
# Tracing
TRACING_ENABLED=true
TRACING_OTLP_ENDPOINT=localhost:4317
TRACING_OTLP_INSECURE=true
TRACING_SAMPLE_RATE=0.1
