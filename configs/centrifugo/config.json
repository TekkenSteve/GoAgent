{
  "broker": {
    "enabled": true,
    "type": "redis",
    "redis": {
      "address": ["redis://redis:6379"]
    }
  },
  "engine": {
    "type": "redis",
    "redis": {
      "address": ["redis://redis:6379"]
    }
  },
  "client": {
    "allow_anonymous_connect_without_token": false
  },
  "channel": {
    "namespaces": [
      {
        "name": "agentos",
        "history_size": 100,
        "history_ttl": "300s",
        "allow_subscribe_for_client": true,
        "allow_subscribe_for_anonymous": false,
        "allow_history_for_client": true,
        "allow_history_for_anonymous": false
      }
    ]
  },
  "admin": {
    "enabled": true
  }
}
